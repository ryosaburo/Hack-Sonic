# backend/.env にコピーして使う（.env は Git に入れない）

# 開発: 何も書かなければ SQLite（./dev.db）を使う
# DATABASE_URL=sqlite:///./dev.db

# 本番: Supabase の接続文字列（Project Settings → Database → Connection string）
#   常時起動のサーバー（Render / Fly.io など）: Session pooler（ポート 5432）
#   サーバーレス（Vercel Functions など）: Transaction pooler（ポート 6543）
# postgresql:// のまま貼れば、アプリ側で psycopg 3 用に読み替える。末尾に ?sslmode=require を付ける。
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# 本番のフロントのURL（CORS で許可する。複数ならカンマ区切り）
# CORS_ORIGINS=https://your-app.vercel.app
