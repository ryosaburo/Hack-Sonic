# frontend/.env.local にコピーして使う（Git には入れない）。本番は Vercel の環境変数に設定する

# バックエンドのURL（何も書かなければ http://localhost:8000）
# VITE_API_BASE=http://localhost:8000

# ログイン（Supabase Auth）。どちらも無ければログイン機能を出さず、端末ごとの保存だけで遊べる
# Project Settings → API の Project URL と anon（publishable）キー。anon キーは公開してよいキー
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
